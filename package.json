{
	"name": "rebtroblox",
	"version": "4.2.4",
	"author": {
		"name": "nrmu9"
	},
	"private": true,
	"scripts": {
		"build": "node dev/build.js",
		"build:dev": "node dev/build.js --dev",
		"build:chrome": "node dev/build.js --target=chrome",
		"watch": "node dev/build.js --dev --watch",
		"bridge": "node dev/bridge.js",
		"typecheck": "tsc --noEmit",
		"dev": "node dev/dev.js",
		"test:hook": "node test/serve.js",
		"test:dollar": "node test/serve.js dollar",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"package": "node dev/package.js",
		"package:firefox": "node dev/package.js --target=firefox",
		"package:chrome": "node dev/package.js --target=chrome",
		"dev:chrome": "node dev/build.js --dev --watch --target=chrome --out=dist-chrome",
		"test:draco": "node dev/draco.js",
		"test:webstore": "node dev/webstore.test.js",
		"publish:chrome": "node dev/webstore.js",
		"publish:chrome:draft": "node dev/webstore.js --no-publish",
		"publish:chrome:auth": "node dev/webstore.js --auth"
	},
	"devDependencies": {
		"@types/chrome": "^0.3.0",
		"@types/three": "^0.186.0",
		"draco3d": "^1.5.7",
		"esbuild": "^0.28.2",
		"oxlint": "^1.83.0",
		"prettier": "^3.9.8",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"fzstd": "^0.1.1",
		"three": "^0.186.0"
	}
}
