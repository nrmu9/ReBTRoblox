{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["chrome"],

		"strict": true,
		"noImplicitAny": false,
		"noUnusedLocals": true,
		"noFallthroughCasesInSwitch": true,

		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,

		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
